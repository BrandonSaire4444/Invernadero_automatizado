2. PASO 1: BASE DE DATOS - MODELO DE DATOS EN CASSANDRA (CQL)
--------------------------------------------------------------------------------
Ejecutar los siguientes comandos en el contenedor Docker de Cassandra para crear
el espacio de claves y las cuatro tablas analizadas para el control completo.

DROP KEYSPACE IF EXISTS siga_hidroponia;

CREATE KEYSPACE hidroponia_pro 
WITH replication = {'class': 'SimpleStrategy', 'replication_factor': 1};

USE hidroponia_pro;

-- 1. Tabla para control de acceso (Login)
CREATE TABLE usuarios (
    username text PRIMARY KEY,
    password_hash text,
    nombre text
);

-- 2. Tabla de referencia de cultivos (Parámetros base para la regulación dinámica)
CREATE TABLE config_cultivos (
    id_cultivo text PRIMARY KEY,
    nombre_verdura text,
    temp_min float,
    temp_max float,
    hum_min float,
    hum_max float,
    ph_min float,
    ph_max float,
    luz_min float,
    luz_max float    
);

-- 3. Tabla para el histórico de sensores (Optimizada para series temporales)
CREATE TABLE lecturas_sensores (
    origen text,
    fecha_hora timestamp,
    temperatura float,
    humedad float,
    ph float,
    luz float,
    PRIMARY KEY (origen, fecha_hora)
) WITH CLUSTERING ORDER BY (fecha_hora DESC);

-- 4. Tabla de estado actual instantáneo de los actuadores
CREATE TABLE estado_actuadores (
    componente text PRIMARY KEY,
    estado text,
    ultima_actualizacion timestamp
);

