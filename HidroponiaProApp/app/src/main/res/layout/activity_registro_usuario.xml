<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear Nueva Cuenta"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Regístrese como operador del sistema SCADA"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp"/>

        <!-- CAMPO: NOMBRE COMPLETO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre Completo:"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/txtRegistroNombre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ej: Paul Marlon"
            android:inputType="textPersonName"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="1dp"/>

        <!-- CAMPO: USERNAME -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre de Usuario (Login):"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/txtRegistroUsername"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ej: paul_marlon"
            android:inputType="text"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="1dp"/>

        <!-- CAMPO: CONTRASEÑA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contraseña:"
            android:textStyle="bold"
            android:textColor="#475569"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/txtRegistroPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="32dp"
            android:elevation="1dp"/>

        <!-- BOTÓN DE ENVÍO -->
        <Button
            android:id="@+id/btnEnviarRegistro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="REGISTRAR USUARIO"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#3B82F6"
            android:elevation="2dp"/>

    </LinearLayout>
</ScrollView>