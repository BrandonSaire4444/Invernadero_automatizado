<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:fillViewport="true"
    tools:context=".RegistrarCultivoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado de la Ventana -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌱 CONFIGURAR NUEVO CULTIVO"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inserción de diccionarios de control en Cassandra"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- SECCIÓN 1: IDENTIFICADORES DE TEXTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre Comercial / Común del Cultivo"
                android:textColor="#334155"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/txtNombreVerdura"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej: Lechuga Crespa, Tomate Cherry..."
                android:inputType="textCapSentences"
                android:padding="10dp"
                android:background="#F8FAFC"/>
        </LinearLayout>

        <!-- SECCIÓN 2: LÍMITES OPERATIVOS (FLOATS) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UMBRALES DE ALERTA SCADA (RANGOS CONTROLADOS)"
            android:textColor="#475569"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Fila Temperatura -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Límites de Temperatura (°C)"
            android:textColor="#475569"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="12dp">
            <EditText
                android:id="@+id/txtTempMin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Mínima (Ej: 18.5)"
                android:inputType="numberDecimal"
                android:layout_marginEnd="6dp"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:elevation="1dp"/>
            <EditText
                android:id="@+id/txtTempMax"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Máxima (Ej: 26.0)"
                android:inputType="numberDecimal"
                android:layout_marginStart="6dp"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:elevation="1dp"/>
        </LinearLayout>

        <!-- Fila Humedad -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Límites de Humedad Ambiental (%)"
            android:textColor="#475569"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="12dp">
            <EditText
                android:id="@+id/txtHumMin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Mínima (Ej: 50)"
                android:inputType="numberDecimal"
                android:layout_marginEnd="6dp"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:elevation="1dp"/>
            <EditText
                android:id="@+id/txtHumMax"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Máxima (Ej: 80)"
                android:inputType="numberDecimal"
                android:layout_marginStart="6dp"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:elevation="1dp"/>
        </LinearLayout>

        <!-- Fila pH del agua -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rango de Tolerancia de pH (Acidez)"
            android:textColor="#475569"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="12dp">
            <EditText
                android:id="@+id/txtPhMin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Mínimo (Ej: 5.5)"
                android:inputType="numberDecimal"
                android:layout_marginEnd="6dp"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:elevation="1dp"/>
            <EditText
                android:id="@+id/txtPhMax"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Máximo (Ej: 6.8)"
                android:inputType="numberDecimal"
                android:layout_marginStart="6dp"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:elevation="1dp"/>
        </LinearLayout>

        <!-- Fila Luminosidad -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Umbrales de Iluminación Sol/Soporte (Lux)"
            android:textColor="#475569"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="28dp">
            <EditText
                android:id="@+id/txtLuzMin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Mínima (Ej: 300)"
                android:inputType="numberDecimal"
                android:layout_marginEnd="6dp"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:elevation="1dp"/>
            <EditText
                android:id="@+id/txtLuzMax"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Máxima (Ej: 900)"
                android:inputType="numberDecimal"
                android:layout_marginStart="6dp"
                android:background="#FFFFFF"
                android:padding="10dp"
                android:elevation="1dp"/>
        </LinearLayout>

        <!-- ACCIONES -->
        <Button
            android:id="@+id/btnGuardarCultivo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="💾 Subir Parámetros a API"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:elevation="4dp"/>

        <Button
            android:id="@+id/btnCancelarCultivo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Cancelar Operación"
            android:backgroundTint="#64748B"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>