<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Tarjeta Central de Autenticación -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Encabezado del Sistema -->
            <TextView
                android:id="@+id/lbl_titulo_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="I Cultivo"
                android:textColor="#1A237E"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="Proyecto Integrador"
                android:textColor="#757575"
                android:textSize="12sp" />

            <!-- Campo: Usuario -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/txt_username"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@android:drawable/editbox_background"
                android:hint="Ej: Juanito"
                android:inputType="textPersonName"
                android:paddingLeft="12dp"
                android:textSize="16sp" />

            <!-- Campo: Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contraseña"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/txt_password"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:background="@android:drawable/editbox_background"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:paddingLeft="12dp"
                android:textSize="16sp" />

            <!-- Botón de Acceso Seguro -->
            <Button
                android:id="@+id/btn_ingresar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#1A237E"
                android:text="INGRESAR"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <!-- 🟢 NUEVO: Botón de Registro integrado manteniendo la línea visual -->
            <Button
                android:id="@+id/btn_ir_registrar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#E8EAF6"
                android:text="REGISTRAR NUEVO USUARIO"
                android:textColor="#1A237E"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                style="?android:attr/borderlessButtonStyle" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>